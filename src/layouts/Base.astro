---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Aravindh Jawahar — AI product engineer',
  description = 'AI product engineer in Chennai. I build AI features and the production systems they run on, for platforms serving 100K+ daily users.',
  noindex = false,
} = Astro.props;

const fontsUrl =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Martian+Mono:wght@400&display=swap';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aravindh Jawahar',
  jobTitle: 'AI Product Engineer',
  url: Astro.site?.href,
  email: 'mailto:j.aravindh@zohomail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Chennai', addressCountry: 'IN' },
  sameAs: ['https://www.linkedin.com/in/aravindh-jawahar', 'https://github.com/aravindh-jawahar'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060907" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Loaded without blocking first paint; text shows in the fallback font until it arrives. -->
    <link rel="stylesheet" href={fontsUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>
