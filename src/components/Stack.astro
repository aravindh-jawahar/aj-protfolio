---
import { stack } from '../data/stack';
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <h2 id="stack-title">Stack</h2>
  <dl>
    {
      stack.map((group) => (
        <div class="group">
          <dt>{group.name}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  dl { display: grid; gap: var(--space-2); max-width: 52rem; }
  .group { display: grid; grid-template-columns: 12rem 1fr; gap: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--grid); }
  dt { font-weight: 500; }
  dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 719px) {
    .group { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
