---
import { stack } from '../data/stack';
---

<section id="stack" class="section container" aria-labelledby="stack-title">
  <h2 id="stack-title" class="section__title">Stack</h2>
  <dl class="stack">
    {
      stack.map((group) => (
        <div class:list={['card group', { 'group--featured': group.featured }]}>
          <dt>{group.name}</dt>
          {group.featured ? (
            <dd>
              <ul class="pills">{group.items.map((item) => <li>{item}</li>)}</ul>
            </dd>
          ) : (
            <dd>{group.items.join(', ')}</dd>
          )}
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stack { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  .group { padding: var(--space-3); }
  .group--featured {
    grid-column: 1 / -1;
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: radial-gradient(60% 120% at 100% 0%, var(--glow), transparent 70%), linear-gradient(180deg, var(--surface-2), var(--surface));
  }
  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; }
  .pills li { padding: 0.25rem 0.75rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); color: var(--ink); }
  dt { font-weight: 700; color: var(--accent); margin-bottom: var(--space-1); }
  dd { margin: 0; color: var(--ink-muted); font-size: var(--step--1); }
  @media (max-width: 999px) {
    .stack { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 479px) {
    .stack { grid-template-columns: 1fr; }
  }
</style>
