---
import { stack } from '../data/stack';
---

<section id="stack" class="section container" aria-labelledby="stack-title">
  <h2 id="stack-title" class="section__title">Stack</h2>
  <dl class="stack">
    {
      stack.map((group) => (
        <div class="card group">
          <dt>{group.name}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stack { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  .group { padding: var(--space-3); }
  dt { font-weight: 700; color: var(--accent); margin-bottom: var(--space-1); }
  dd { margin: 0; color: var(--ink-muted); font-size: var(--step--1); }
  @media (max-width: 999px) {
    .stack { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 479px) {
    .stack { grid-template-columns: 1fr; }
  }
</style>
