---
import { services, type ServiceIcon } from '../data/site';

const icons: Record<ServiceIcon, string> = {
  ai: 'M12 3v3m0 12v3M3 12h3m12 0h3M7 7l2 2m6 6 2 2m0-10-2 2m-6 6-2 2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  stack: 'M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  pulse: 'M3 12h4l2-6 4 12 2-6h6',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm9 16-4-4',
};
---

<section id="services" class="section container" aria-labelledby="services-title">
  <div class="services__intro">
    <h2 id="services-title" class="section__title">What I work on</h2>
    <p class="section__lead">Four kinds of work I own end to end, from tech spec to production.</p>
  </div>
  <div class="services__grid">
    {
      services.map((service) => (
        <article class="card service">
          <span class="service__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[service.icon]} />
            </svg>
          </span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .services__intro { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); align-items: end; margin-bottom: var(--space-4); }
  .services__intro .section__title { margin: 0; }
  .services__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); }
  .service { padding: var(--space-3); transition: border-color 150ms ease; }
  .service:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .service__icon {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent);
    margin-bottom: var(--space-3);
  }
  h3 { font-size: var(--step-1); margin-bottom: var(--space-1); }
  .service p { color: var(--ink-muted); font-size: var(--step--1); }
  @media (max-width: 999px) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 719px) {
    .services__intro { grid-template-columns: 1fr; }
    .services__grid { grid-template-columns: 1fr; }
  }
</style>
