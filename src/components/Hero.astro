---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import portrait from '../assets/images/portrait.jpg';
import { heroStats, site } from '../data/site';

const [users, years, uptime] = heroStats;
---

<section id="top" class="hero container">
  <div class="hero__copy">
    <p class="hero__eyebrow"><span class="dot" aria-hidden="true"></span>{site.title} · {site.location}</p>
    <h1>{site.headline}</h1>
    <p class="hero__lead">{site.lead}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={url(site.resumePath)} download>Download resume <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={url('/#contact')}>Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="bento">
    <div class="card bento__feature">
      <p class="stat__value">{users.value}</p>
      <p class="stat__label">{users.label}</p>
      <div class="orb" aria-hidden="true"></div>
    </div>
    <div class="card bento__photo">
      <Picture src={portrait} alt="Aravindh Jawahar" width={420} formats={['avif', 'webp']} loading="eager" />
    </div>
    <div class="card bento__small">
      <p class="stat__value">{uptime.value}</p>
      <p class="stat__label">{uptime.label}</p>
    </div>
    <div class="card bento__small">
      <p class="stat__value">{years.value}</p>
      <p class="stat__label">{years.label}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-5); align-items: center;
    padding-block: var(--space-6) var(--space-5);
  }
  /* The green haze behind the hero, standing in for the reference's lighting. */
  .hero::before {
    content: ''; position: absolute; inset: -10% -20% auto; height: 120%; z-index: -1;
    background:
      radial-gradient(40% 50% at 75% 40%, var(--glow), transparent 70%),
      radial-gradient(30% 40% at 10% 10%, rgba(76, 175, 80, 0.08), transparent 70%);
    pointer-events: none;
  }
  .hero__eyebrow { display: flex; align-items: center; gap: 0.5rem; color: var(--ink-muted); font-size: var(--step--1); margin-bottom: var(--space-2); }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  h1 { font-size: clamp(2.441rem, 5vw, 3.815rem); font-weight: 800; line-height: 1.05; }
  .hero__lead { color: var(--ink-muted); font-size: var(--step-1); margin-top: var(--space-3); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }

  .bento { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .bento .card { padding: var(--space-3); }
  .bento__feature { position: relative; overflow: hidden; min-height: 20rem; text-align: center; }
  .bento__photo { padding: 0 !important; overflow: hidden; }
  .bento__photo :global(picture), .bento__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .bento__small { text-align: center; }
  .stat__value { font-size: var(--step-3); font-weight: 800; line-height: 1.1; }
  .stat__label { color: var(--ink-muted); font-size: var(--step--1); margin-inline: auto; }

  .orb {
    position: absolute; left: 50%; bottom: -1.5rem; width: 13rem; aspect-ratio: 1;
    transform: translateX(-50%) rotateX(58deg) rotateZ(-20deg);
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 25%, rgba(220, 255, 222, 0.9) 0 3%, transparent 14%),
      conic-gradient(from 210deg, #0a2e10, #3fa346, #b5f0b8, #3fa346, #0f4a18, #0a2e10);
    -webkit-mask: radial-gradient(circle, transparent 36%, #000 37%, #000 69%, transparent 70%);
    mask: radial-gradient(circle, transparent 36%, #000 37%, #000 69%, transparent 70%);
    filter: drop-shadow(0 0 30px rgba(76, 175, 80, 0.45));
  }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; padding-top: var(--space-5); }
  }
  @media (max-width: 479px) {
    .stat__value { font-size: var(--step-2); }
    .bento .card { padding: var(--space-2); }
    .bento__feature { min-height: 16rem; }
    .orb { width: 10rem; }
  }
</style>
