---
import { education } from '../data/education';
import { formatRange } from '../lib/dates';
---

<section id="education" class="section container" aria-labelledby="education-title">
  <h2 id="education-title" class="section__title">Education</h2>
  <div class="degrees">
    {
      education.map((item) => (
        <article class="card degree">
          <span class="dates">{formatRange(item.start, item.end)}</span>
          <h3>{item.degree}</h3>
          <p>{item.school}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .degrees { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .degree { padding: var(--space-3); }
  .dates { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
  h3 { font-size: var(--step-1); margin: var(--space-1) 0 0.25rem; }
  p { color: var(--ink-muted); }
  @media (max-width: 719px) {
    .degrees { grid-template-columns: 1fr; }
  }
</style>
