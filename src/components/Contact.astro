---
import { Picture } from 'astro:assets';
import portrait from '../assets/images/portrait.jpg';
import { site } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <Picture
    src={portrait}
    alt="Aravindh Jawahar"
    width={360}
    formats={['avif', 'webp']}
    class="contact__photo"
    loading="lazy"
  />
  <div>
    <h2 id="contact-title">Contact</h2>
    <p>Based in {site.location}. The quickest way to reach me is email.</p>
    <ul>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.linkedin}>LinkedIn</a></li>
      <li><a href={site.github}>GitHub</a></li>
      <li><a href={site.resumePath} download>Download resume (PDF)</a></li>
    </ul>
  </div>
</section>

<style>
  .contact { display: grid; grid-template-columns: 18rem 1fr; gap: var(--space-4); align-items: start; }
  .contact :global(.contact__photo) { width: 100%; height: auto; }
  ul { list-style: none; padding: 0; margin-top: var(--space-3); display: grid; gap: var(--space-1); font-size: var(--step-1); }
  @media (max-width: 719px) {
    .contact { grid-template-columns: 1fr; }
    .contact :global(.contact__photo) { max-width: 14rem; }
  }
</style>
