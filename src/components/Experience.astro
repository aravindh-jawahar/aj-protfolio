---
import { experience } from '../data/experience';
import { formatRange } from '../lib/dates';
---

<section id="experience" class="section container" aria-labelledby="experience-title">
  <h2 id="experience-title" class="section__title center">Work experience</h2>
  <p class="section__lead center">
    Six years shipping production systems — from KPI dashboards to AI assistants on a 100K+ daily-user platform.
  </p>

  <div class="roles">
    {
      experience.map((role) => (
        <details class="card role" data-stack={role.colour}>
          <summary>
            <span class="badge" aria-hidden="true">{role.badge}</span>
            <span class="role__who">
              <strong>{role.company}</strong>
              <span class="muted">{role.location}</span>
            </span>
            <span class="role__what">
              <strong>{role.role}</strong>
              <span class="dates">
                {role.end === null && <span class="live" aria-hidden="true" />}
                {formatRange(role.start, role.end)}
              </span>
            </span>
            <span class="btn btn--small btn--ghost role__toggle" aria-hidden="true" />
          </summary>
          <div class="role__body">
            {role.summary && <p>{role.summary}</p>}
            <ul class="pills" aria-label="Stack">
              {role.stack.map((tech) => <li>{tech}</li>)}
            </ul>
            {role.details.map((group) => (
              <>
                {group.heading && <h3>{group.heading}</h3>}
                <ul class="points">
                  {group.points.map((point) => <li>{point}</li>)}
                </ul>
              </>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .center { text-align: center; margin-inline: auto; }
  .roles { display: grid; gap: var(--space-1); margin-top: var(--space-4); }
  [data-stack='ruby'] { --c: var(--span-ruby); }
  [data-stack='node'] { --c: var(--span-node); }
  [data-stack='python'] { --c: var(--span-python); }

  summary {
    display: grid; grid-template-columns: 3rem 1fr 1.2fr auto; gap: var(--space-3); align-items: center;
    padding: var(--space-2) var(--space-3); cursor: pointer; list-style: none; border-radius: var(--radius);
  }
  summary::-webkit-details-marker { display: none; }
  .role[open] { border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }

  .badge {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    font-weight: 800; font-size: var(--step--1);
    color: var(--c); background: color-mix(in srgb, var(--c) 15%, transparent);
  }
  .role__who, .role__what { display: grid; }
  .muted { color: var(--ink-muted); font-size: var(--step--1); }
  .dates { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-muted); }
  .live {
    display: inline-block; width: 0.45rem; height: 0.45rem; margin-right: 0.4rem; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 8px var(--accent);
  }
  .role__toggle::before { content: 'Details'; }
  .role[open] .role__toggle { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .role[open] .role__toggle::before { content: 'Hide'; }

  .role__body {
    margin: 0 var(--space-3) var(--space-3) calc(3rem + 2 * var(--space-3));
    padding-top: var(--space-2); border-top: 1px solid var(--border); color: var(--ink-muted);
  }
  .role__body > * + * { margin-top: var(--space-1); }
  .role__body h3 { color: var(--ink); font-size: var(--step-0); margin-top: var(--space-2); }
  .points { padding-left: 1.1rem; max-width: var(--measure); }
  .pills { display: flex; flex-wrap: wrap; gap: 0.375rem; list-style: none; padding: 0; }
  .pills li { font-size: 0.75rem; padding: 0.125rem 0.625rem; border: 1px solid var(--border); border-radius: 999px; }

  @media (max-width: 719px) {
    summary { grid-template-columns: 2.75rem 1fr auto; gap: var(--space-2); padding: var(--space-2); }
    .role__what { grid-column: 2 / -1; grid-row: 2; }
    .role__toggle { grid-column: 3; grid-row: 1; }
    .role__body { margin: 0 var(--space-2) var(--space-2); }
  }
</style>
