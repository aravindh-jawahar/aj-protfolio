---
import type { Span } from '../data/types';
import { axisFor, formatRange, orderSpans, spanBox } from '../lib/timeline';
import SpanDetail from './SpanDetail.vue';

interface Props {
  spans: Span[];
  now: string;
}

const { spans, now } = Astro.props;
const axis = axisFor(spans, now);
const rows = orderSpans(spans).filter(({ span }) => span.parentId !== null);
---

<section class="career-list" aria-label="Career timeline">
  <ol>
    {
      rows.map(({ span }) => {
        const box = spanBox(span, axis, now);
        return (
          <li>
            <span class="bar" data-stack={span.stackColour} style={`--offset: ${box.offset}; --size: ${box.size}`} />
            <details>
              <summary>
                {span.label} <span class="span__range mono">{formatRange(span)}</span>
              </summary>
              <SpanDetail span={span} range={formatRange(span)} />
            </details>
          </li>
        );
      })
    }
  </ol>
</section>
